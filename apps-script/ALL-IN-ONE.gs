// ======================================================================== Demo.gs
/**
 * DEMO mode — public trial copy of e-Work Permit (fictional company "บริษัท ตัวอย่าง อินดัสทรี จำกัด").
 *
 * Run ONCE from the Apps Script editor:  setupDemo()
 *   → creates the spreadsheet + Drive folder (setupSystem), sets the demo passwords in
 *     Script Properties, writes the sample data (seedDemoData_) and installs ONE daily
 *     time-driven trigger that runs demoAutoReset().
 * demoAutoReset() (daily, ~03:00 Asia/Bangkok) re-seeds when ≥ 3 days have passed since
 * Script Property DEMO_LAST_RESET. resetDemoNow() re-seeds immediately (manual).
 *
 * What the demo neuters (WP_DEMO = true):
 *  - Teams notifications / approval reminders → no-ops with a log line (Permits.gs)
 *  - "รีเซ็ตข้อมูล" (reset_data, wipes the whole DB) → refused
 *  - deleting a SAMPLE permit (id ≤ DEMO_SEED_MAX_ID) → refused (permits a visitor created can be deleted)
 *  - the demo accounts (DEMO_SEED.users): password / roles cannot be changed, accounts cannot be
 *    disabled, and wrong passwords never lock them (Auth.gs)
 *  - wrong "reset passwords" never lock edit/delete for everybody
 * Public API: GET ?action=demo_info → {demo, reset_days, last_reset, next_reset, server_time, track_example}
 *
 * The sample data is DEMO_SEED (DemoSeed.gs, plain data); signatures/photo are DEMO_ASSETS
 * (DemoAssets.gs, generated by tools/gen-demo-assets.js).
 */
var WP_DEMO = true;
var DEMO_RESET_DAYS = 3;
var DEMO_RESET_SLACK_SEC = 2 * 3600;   // the daily trigger fires anywhere inside its hour
var DEMO_RESET_HOUR = 3;               // daily trigger hour (project time zone Asia/Bangkok)
var DEMO_RESET_HANDLER = 'demoAutoReset';
var DEMO_PROP_LAST_RESET = 'DEMO_LAST_RESET';
var DEMO_PROP_SEED_FILES = 'DEMO_SEED_FILES';
var DEMO_PROP_SEED_MAX_ID = 'DEMO_SEED_MAX_ID';
var DEMO_HASH_ROUNDS = 1000;           // public passwords: fewer rounds keep the reset fast

function demoIsOn_() { return typeof WP_DEMO !== 'undefined' && WP_DEMO === true; }

/** A demo account from DEMO_SEED.users (protected while the demo is on). */
function demoProtectedUser_(u) {
  if (!demoIsOn_() || !u) return false;
  var name = String(u.username || u).toLowerCase();
  return DEMO_SEED.users.some(function (x) { return x.username.toLowerCase() === name; });
}

/** Highest permit id written by the last seed (sample permits cannot be deleted). */
function demoSeedMaxId_() { return Number(props_().getProperty(DEMO_PROP_SEED_MAX_ID)) || 0; }

function demoRefuse_(what) {
  fail_('ระบบทดลอง (Demo): ' + what + ' — ข้อมูลทั้งหมดจะถูกรีเซ็ตกลับเป็นค่าเริ่มต้นอัตโนมัติทุก ' + DEMO_RESET_DAYS + ' วัน', 'DEMO');
}

/** Drive files created by the last seed (signatures / photo) — never trashed by a single delete. */
function demoSeedFile_(id) {
  if (!demoIsOn_() || !id) return false;
  var ids = jdec_(props_().getProperty(DEMO_PROP_SEED_FILES) || '', []);
  return Array.isArray(ids) && ids.indexOf(String(id)) >= 0;
}

// ---------------------------------------------------------------- owner functions (Apps Script editor)
/** Run ONCE after pasting the code: setup + sample data + the daily auto-reset trigger. */
function setupDemo() {
  var props = props_();
  props.setProperties({ WP_INITIAL_ADMIN_PASSWORD: DEMO_SEED.password, WP_RESET_PASSWORD: DEMO_SEED.resetPassword }, false);
  var setup = setupSystem();
  var seed = seedDemoData_();
  var trigger = installDemoResetTrigger_();
  var result = {
    spreadsheetUrl: setup.spreadsheetUrl, folderUrl: setup.folderUrl, seed: seed, trigger: trigger,
    logins: DEMO_SEED.users.map(function (u) { return u.username + ' / ' + DEMO_SEED.password + ' (' + u.roles + ')'; }),
    next: 'Deploy → New deployment → Web app (Execute as: Me, Who has access: Anyone) แล้วนำ URL /exec ไปใส่ใน docs/config.js'
  };
  Logger.log(JSON.stringify(result, null, 2));
  return result;
}

/** Manual reset (Apps Script editor): sample data back to default now. */
function resetDemoNow() {
  var r = seedDemoData_();
  Logger.log(JSON.stringify(r, null, 2));
  return r;
}

/** Daily trigger: re-seeds when ≥ DEMO_RESET_DAYS days have passed since DEMO_LAST_RESET. Never throws. */
function demoAutoReset() {
  try {
    if (!props_().getProperty(WP_PROP_SPREADSHEET)) return { ok: false, skipped: 'setupDemo() ยังไม่ได้รัน' };
    var last = demoLastResetTs_(), now = nowTs_();
    if (last && now - last < DEMO_RESET_DAYS * 86400 - DEMO_RESET_SLACK_SEC) {
      return { ok: true, reset: false, last_reset: demoIso_(last), next_reset: demoIso_(demoNextResetTs_(last)) };
    }
    var seed = seedDemoData_();
    console.log('DEMO auto reset: ' + JSON.stringify(seed));
    return { ok: true, reset: true, seed: seed };
  } catch (e) {
    console.warn('DEMO auto reset failed: ' + (e && e.message ? e.message : e));
    return { ok: false, error: String(e && e.message ? e.message : e) };
  }
}

/** Exactly one daily trigger for demoAutoReset (older ones of the same handler are removed first). */
function installDemoResetTrigger_() {
  var removed = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === DEMO_RESET_HANDLER) { ScriptApp.deleteTrigger(t); removed++; }
  });
  ScriptApp.newTrigger(DEMO_RESET_HANDLER).timeBased().everyDays(1).atHour(DEMO_RESET_HOUR).create();
  return { removed: removed, installed: 1, handler: DEMO_RESET_HANDLER, daily_at_hour: DEMO_RESET_HOUR };
}

// ---------------------------------------------------------------- demo info (public API)
function demoIso_(ts) { return ts ? new Date(ts * 1000).toISOString() : ''; }

function demoLastResetTs_() {
  var v = props_().getProperty(DEMO_PROP_LAST_RESET);
  var ms = v ? Date.parse(v) : NaN;
  return isNaN(ms) ? 0 : Math.floor(ms / 1000);
}

/** First daily trigger slot (DEMO_RESET_HOUR:00 Bangkok) at which demoAutoReset will re-seed. */
function demoNextResetTs_(last) {
  if (!last) return 0;
  var due = last + DEMO_RESET_DAYS * 86400 - DEMO_RESET_SLACK_SEC;
  var dayStart = Math.floor((due + 7 * 3600) / 86400) * 86400 - 7 * 3600; // Bangkok midnight of that day
  var slot = dayStart + DEMO_RESET_HOUR * 3600;
  if (slot < due) slot += 86400;
  return slot;
}

/** action=demo_info (GET/POST, public): reset schedule + a sample permit for the tracking page. */
function apiDemoInfo_(p, ctx) {
  var last = demoLastResetTs_();
  var out = {
    demo: demoIsOn_(), reset_days: DEMO_RESET_DAYS, reset_hour: DEMO_RESET_HOUR,
    last_reset: demoIso_(last), next_reset: demoIso_(demoNextResetTs_(last)),
    server_time: now_().toISOString(), track_example: null
  };
  if (!props_().getProperty(WP_PROP_SPREADSHEET)) return out;
  out.track_example = cachedRead_(ctx, 'demo_example', null, function () {
    var rows = table_(ctx, 'permits').rows, ex = null;
    // newest sample permit still "อนุมัติ / ปฏิบัติงาน", else any sample permit
    rows.slice().sort(function (a, b) { return Number(b.id) - Number(a.id); }).some(function (r) {
      if (Number(r.id) > demoSeedMaxId_()) return false;
      if (!ex) ex = r;
      if (effectiveStatus_(r) === 'approved') { ex = r; return true; }
      return false;
    });
    return { data: ex ? { permit_no: ex.permit_no, phone: ex.requester_phone } : null, until: permitsValidUntil_(rows) };
  });
  return out;
}

// ---------------------------------------------------------------- seeding
/**
 * Wipes users / permits / permit_logs and every file of the app Drive folder, then writes
 * the default sample data (DEMO_SEED) with dates relative to now. Requires setupSystem().
 */
function seedDemoData_() {
  folder_(); // throws SETUP before anything is touched
  var out = withLock_(function () {
    var ctx = { tables: {} };
    var ut = table_(ctx, 'users'), pt = table_(ctx, 'permits'), lt = table_(ctx, 'permit_logs');
    (WP_SCHEMA_OPTIONAL.users || []).forEach(function (h) { ensureColumn_(ut, h); });
    (WP_SCHEMA_OPTIONAL.permits || []).forEach(function (h) { ensureColumn_(pt, h); });
    var oldNos = pt.rows.map(function (r) { return r.permit_no; });

    // Drive: everything in the app folder → trash (sample files + whatever visitors uploaded)
    var trashed = 0, it = folder_().getFiles();
    while (it.hasNext()) {
      var f = it.next();
      try { if (!f.isTrashed()) { f.setTrashed(true); trashed++; } } catch (e) { console.warn('demo: trash failed'); }
    }
    var files = demoCreateFiles_();
    var data = demoBuildSeed_(now_(), files);

    [[ut, data.users], [pt, data.permits], [lt, data.logs]].forEach(function (x) {
      var t = x[0], rows = x[1], sh = t.sheet, last = sh.getLastRow();
      if (last > 1) sh.getRange(2, 1, last - 1, sh.getMaxColumns()).clearContent();
      if (!rows.length) return;
      if (sh.getMaxRows() < rows.length + 1) sh.insertRowsAfter(sh.getMaxRows(), rows.length + 1 - sh.getMaxRows());
      var range = sh.getRange(2, 1, rows.length, t.headers.length);
      range.setNumberFormat('@');
      range.setValues(rows.map(function (o) { return rowValues_(t, o); }));
    });

    // lockouts of the demo accounts / tracking numbers / reset password start fresh
    var cache = cache_();
    DEMO_SEED.users.forEach(function (u) { cache.remove('wplf_' + u.username.toLowerCase()); });
    oldNos.concat(data.permits.map(function (r) { return r.permit_no; })).forEach(function (no) { if (no) cache.remove('wptf_' + no); });
    cache.remove(WP_RESET_FAIL_KEY);

    var fileIds = Object.keys(files.sig).map(function (k) { return files.sig[k]; });
    if (files.photo) fileIds.push(files.photo.id);
    var at = now_().toISOString();
    props_().setProperties({
      DEMO_LAST_RESET: at,
      DEMO_SEED_FILES: JSON.stringify(fileIds),
      DEMO_SEED_MAX_ID: String(data.permits.length)
    }, false);
    var counts = {};
    data.permits.forEach(function (r) { var es = effectiveStatus_(r); counts[es] = (counts[es] || 0) + 1; });
    return {
      users: data.users.length, permits: data.permits.length, logs: data.logs.length, by_status: counts,
      files_created: fileIds.length, files_trashed: trashed, last_reset: at,
      next_reset: demoIso_(demoNextResetTs_(demoLastResetTs_()))
    };
  });
  return out;
}

/** Stores the sample signatures + work-done photo (DEMO_ASSETS) in the app folder. */
function demoCreateFiles_() {
  var sig = {}, i = 0;
  Object.keys(DEMO_ASSETS.signatures).forEach(function (name) {
    sig[name] = saveDriveFile_(Utilities.base64Decode(DEMO_ASSETS.signatures[name]), 'image/png', 'demo_signature_' + (++i) + '.png');
  });
  var bytes = Utilities.base64Decode(DEMO_ASSETS.photo);
  return { sig: sig, photo: { id: saveDriveFile_(bytes, 'image/png', 'demo_work_done.png'), size: bytes.length } };
}

function demoAddMin_(hhmm, min) {
  var m = /^(\d{1,2}):(\d{2})$/.exec(String(hhmm || ''));
  if (!m) return '';
  var t = ((+m[1] * 60 + +m[2] + min) % 1440 + 1440) % 1440;
  return (t < 600 ? '0' : '') + Math.floor(t / 60) + ':' + (t % 60 < 10 ? '0' : '') + (t % 60);
}

/** Checklist of the request form for the selected work types (sanitized like submit). */
function demoChecklist_(types, extra, crew, company, n) {
  var raw = {};
  var who = function (i) { return crew[i] ? crew[i][0] : ''; };
  types.forEach(function (k) {
    WP_DATA.workTypes[k].items.forEach(function (it, j) {
      switch (it.type) {
        case 'check': raw[it.id] = (j + n) % 11 !== 5; break; // most items ticked, now and then one is not
        case 'ppe':
          raw[it.id] = { sel: it.options.filter(function (o, x) { return x < 3 + (n % 3); }), other: '' };
          break;
        case 'checktext': raw[it.id] = { on: false, text: '' }; break;
        case 'choice':
          if (/^cs4_/.test(it.id)) raw[it.id] = it.id === 'cs4_1' ? 'ใช่' : (it.id === 'cs4_12' ? '' : 'ไม่ใช่');
          else raw[it.id] = it.id === 'cs5_18' ? '' : (it.id === 'cs5_11' && n % 2 ? it.opts[1] : it.opts[0]);
          break;
        case 'text': raw[it.id] = ''; break;
        default: break;
      }
    });
  });
  if (types.indexOf('confined') >= 0) {
    raw.cs_kind = { sel: types.indexOf('hot') >= 0 ? ['งานที่มีประกายไฟ', 'งานเชื่อม/งานตัด'] : ['งานล้างถัง'], other: '' };
    raw.cs_sup = who(0); raw.cs_sup_co = company;
    raw.cs_help1 = who(3) || who(1); raw.cs_help2 = who(4);
    raw.cs_work1 = who(1); raw.cs_work2 = who(2);
  }
  if (types.indexOf('electric') >= 0) {
    raw.e6 = { on: true, text: 'ต้องมีผู้ควบคุมงานไฟฟ้าอยู่หน้างานตลอดเวลา' };
    raw.e8 = { on: true, text: 'สำเนาบัตรช่างไฟฟ้า' };
  }
  if (types.indexOf('height') >= 0) raw.ht61 = true;
  Object.keys(extra || {}).forEach(function (k) { raw[k] = extra[k]; });
  return cleanChecklist_(raw);
}

/**
 * Pure builder (no Drive / sheet access): DEMO_SEED → rows for users / permits / permit_logs
 * with dates relative to `now`. `files` = {sig: {fullname: driveId}, photo: {id, size}} (tests pass fakes).
 */
function demoBuildSeed_(now, files) {
  files = files || { sig: {}, photo: null };
  var S = DEMO_SEED, nowMs = now.getTime();
  var td = /^(\d{4})-(\d{2})-(\d{2})$/.exec(Utilities.formatDate(now, WP_TZ, 'yyyy-MM-dd'));
  var d0 = Date.UTC(+td[1], +td[2] - 1, +td[3]) - 7 * 3600000; // today 00:00 Bangkok (ms)
  var at = function (day, hhmm) {
    var m = /^(\d{1,2}):(\d{2})$/.exec(hhmm);
    return d0 + day * 86400000 + (+m[1] * 60 + +m[2]) * 60000;
  };
  var stamp = function (ms) { return Utilities.formatDate(new Date(ms), WP_TZ, 'yyyy-MM-dd HH:mm:ss'); };
  var dateOf = function (day) { return Utilities.formatDate(new Date(d0 + day * 86400000 + 12 * 3600000), WP_TZ, 'yyyy-MM-dd'); };
  var sig = function (name) { return (files.sig && files.sig[name]) || ''; };
  var MIN = 60000;

  var users = S.users.map(function (u, i) {
    var salt = randomHex_(32);
    return {
      id: i + 1, username: u.username, salt: salt, password_hash: hashPassword_(S.password, salt, DEMO_HASH_ROUNDS),
      iterations: String(DEMO_HASH_ROUNDS), fullname: u.fullname, position: u.position, active: '1', must_change: '0',
      created_at: stamp(d0 - 30 * 86400000 + 9 * 3600000 + i * 7 * MIN), roles: u.roles, email: u.email, phone: u.phone
    };
  });
  var byU = {};
  users.forEach(function (u) { byU[u.username] = u; });

  var built = S.permits.map(function (pl, i) {
    var R = S.requesters[pl.req];
    var crew = (S.crews[pl.req] || []).slice(0, pl.crew || 1);
    var parts = pl.flow.split(':'), kind = parts[0], stageWanted = parts[1] || '';
    var resp = byU[pl.resp] || null, area = byU[pl.area] || null, saf = byU[pl.safety] || null;
    var types = pl.types.slice();
    var row = {
      company: WP_DATA.companies[pl.company] || WP_DATA.companies[0], permit_type: pl.ptype, work_types: JSON.stringify(types),
      work_date: dateOf(pl.day), time_from: pl.from, time_to: pl.to,
      requester_title: R.title, requester_name: R.name, requester_company: R.company, requester_phone: R.phone,
      worker_count: String(crew.length), workers: JSON.stringify(crew.map(function (w) { return { name: w[0], role: w[1], idno: '' }; })),
      owner_name: resp ? resp.fullname : '', owner_phone: resp ? resp.phone : '',
      job_detail: pl.job, location: pl.location, token: randomHex_(32),
      requester_sign_file: sig(R.name), owner_sign_file: pl.ownerSign && resp ? sig(resp.fullname) : '',
      attachment_file: '', attachment_name: '', attachment_mime: '',
      approver_id: '', approver_name: '', approver_sign_file: '', approve_comment: '', approved_at: '', closed_at: '',
      responsible_id: resp ? resp.id : '', responsible_name: resp ? resp.fullname : '',
      area_owner_id: '', area_owner_name: '', stage: '', stage_started_at: '',
      area_assigned_at: '', area_approved_at: '', area_sign_file: '', area_comment: '',
      resp_approved_at: '', resp_sign_file: '', resp_comment: '', reject_stage: '',
      last_reminder_at: '', reminder_count: '0',
      item_files: '', work_done_at: '', work_done_note: '', work_done_photos: ''
    };
    var endMs = permitEndTs_(row) * 1000, startMs = at(pl.day, pl.from);

    // ---- approval chain (before the work); moved earlier as a whole if it would lie in the future
    var t = { created: at(pl.cday, pl.ctime) };
    t.resp = t.created + (35 + (i % 4) * 10) * MIN;
    t.area = t.resp + (40 + (i % 3) * 15) * MIN;
    t.safety = t.area + (30 + (i % 5) * 8) * MIN;
    var lastStep = { 'pending:assign': 'created', 'pending:area': 'resp', 'pending:safety': 'area', 'rejected:assign': 'resp', 'rejected:area': 'area' }[pl.flow] || 'safety';
    var limit = nowMs - (5 + i) * MIN;
    if (t[lastStep] > limit) {
      var shift = t[lastStep] - limit;
      Object.keys(t).forEach(function (k) { t[k] -= shift; });
    }
    var logs = [];
    var log = function (ms, action, by, note) { logs.push({ ms: ms, action: action, by_name: by, note: note }); };
    var nt = function (who) { var a = S.notes[who] || []; return a[i % a.length] || ''; };
    log(t.created, 'submit', R.name, 'ยื่นใบขออนุญาตปฏิบัติงาน');
    row.stage = 'assign'; row.stage_started_at = stamp(t.created);
    var last = t.created;
    var rejectAt = function (ms, by, roleKey, st) {
      row.status = 'rejected'; row.approver_id = by.id; row.approver_name = by.fullname;
      row.approve_comment = pl.reason || 'ไม่อนุมัติ'; row.approved_at = stamp(ms); row.reject_stage = st;
      log(ms, 'reject', by.fullname, roleKey ? '[' + WP_DATA.roles[roleKey] + '] ' + row.approve_comment : row.approve_comment);
      last = ms;
    };
    if (pl.flow === 'rejected:assign') {
      rejectAt(t.resp, resp, 'responsible', 'assign');
    } else if (pl.flow !== 'pending:assign') {
      // ขั้นที่ 1: the responsible approves + picks the area owner
      row.resp_approved_at = stamp(t.resp); row.resp_sign_file = sig(resp.fullname); row.resp_comment = nt('resp');
      row.area_owner_id = area.id; row.area_owner_name = area.fullname; row.area_assigned_at = stamp(t.resp);
      row.stage = 'area'; row.stage_started_at = stamp(t.resp);
      log(t.resp, 'resp_approve', resp.fullname, row.resp_comment || 'ผู้รับผิดชอบงานอนุมัติ');
      log(t.resp, 'assign_area', resp.fullname, 'ระบุเจ้าของพื้นที่: ' + area.fullname);
      last = t.resp;
      if (pl.flow === 'rejected:area') {
        rejectAt(t.area, area, 'area_owner', 'area');
      } else if (pl.flow !== 'pending:area') {
        // ขั้นที่ 2: the area owner approves
        row.area_approved_at = stamp(t.area); row.area_sign_file = sig(area.fullname); row.area_comment = nt('area');
        row.stage = 'safety'; row.stage_started_at = stamp(t.area);
        log(t.area, 'area_approve', area.fullname, row.area_comment || 'เจ้าของพื้นที่อนุมัติ');
        last = t.area;
        if (pl.flow === 'rejected:safety') {
          saf = saf || byU.admin;
          rejectAt(t.safety, saf, '', 'safety');
        }
      }
    }
    var ins = {};
    if (kind === 'closed' || kind === 'expired' || kind === 'approved') {
      // ขั้นที่ 3: the จป. approves
      row.status = 'approved'; row.approver_id = saf.id; row.approver_name = saf.fullname;
      row.approver_sign_file = sig(saf.fullname); row.approve_comment = nt('safety'); row.approved_at = stamp(t.safety);
      ins.safety = { permit: { name: saf.fullname, at: stamp(t.safety) } };
      log(t.safety, 'approve', saf.fullname, row.approve_comment || 'อนุมัติให้ปฏิบัติงาน');
      last = t.safety;
      // inspections during the work (only those that already happened)
      var signCell = function (ms, rk, who, sk, viaPage) {
        if (ms > nowMs - MIN) return;
        if (!ins[rk]) ins[rk] = {};
        ins[rk][sk] = { name: who.fullname, at: stamp(ms) };
        if (viaPage) log(ms, 'inspect', who.fullname, WP_DATA.inspectStages[sk] + ' — ' + WP_DATA.inspectRoles[rk]);
        last = Math.max(last, ms);
      };
      var before = startMs + 5 * MIN, during = startMs + Math.floor((endMs - startMs) / 2 / MIN) * MIN, after = endMs + 10 * MIN;
      signCell(before, 'contractor', resp, 'before', true);
      signCell(before + 3 * MIN, 'owner', area, 'before', true);
      signCell(before + 8 * MIN, 'safety', saf, 'before', false);
      signCell(during, 'safety', saf, 'during', false);
      if (pl.done && endMs + 15 * MIN <= nowMs - MIN && files.photo) {
        row.work_done_at = stamp(endMs + 15 * MIN);
        row.work_done_note = pl.done;
        row.work_done_photos = JSON.stringify([{ fid: randomHex_(16), name: 'หลังเสร็จงาน_' + (i + 1) + '.png', mime: 'image/png', size: files.photo.size, file: files.photo.id }]);
        log(endMs + 15 * MIN, 'work_done', R.title + ' ' + R.name, 'ผู้รับเหมาแจ้งเสร็จงาน (รูปถ่าย 1 รูป)\nหมายเหตุ: ' + pl.done);
        last = Math.max(last, endMs + 15 * MIN);
      }
      if (kind === 'closed') {
        signCell(after, 'contractor', resp, 'after', true);
        signCell(after + 4 * MIN, 'owner', area, 'after', true);
        signCell(after + 12 * MIN, 'safety', saf, 'after', false);
        var closeMs = after + (20 + i) * MIN;
        if (closeMs <= nowMs - MIN) {
          log(after + 12 * MIN, 'review', saf.fullname, 'บันทึกผลการตรวจสอบ');
          row.status = 'closed'; row.closed_at = stamp(closeMs);
          log(closeMs, 'close', saf.fullname, 'ตรวจสอบหลังเสร็จงาน ปิดใบอนุญาต');
          last = Math.max(last, closeMs);
        }
      }
    } else if (!row.status) {
      row.status = 'pending';
    }
    row.inspections = JSON.stringify(ins);
    var crewNames = crew.map(function (w) { return w[0]; });
    row.checklist = JSON.stringify(demoChecklist_(types, pl.cl, crew, R.company, i));
    var lt = [];
    if (types.indexOf('electric') >= 0) {
      lt = (pl.loto || []).map(function (l) {
        return { item: l.item, t_on: l.on || '', by_on: l.on ? crewNames[0] : '', t_off: l.off || '', by_off: l.off ? crewNames[0] : '', note: '' };
      });
    }
    row.loto = JSON.stringify(cleanLoto_(lt));
    if (types.indexOf('confined') >= 0) {
      var started = startMs <= nowMs, finished = row.status === 'closed';
      row.confined = JSON.stringify(cleanConfined_({
        gas: started ? [{ o2: '20.9', lel: '0', by: crewNames[0], time: demoAddMin_(pl.from, -10) },
          { o2: '20.8', lel: '0', by: crewNames[0], time: demoAddMin_(pl.from, 120) }] : [],
        entries: started ? crewNames.slice(1, 3).map(function (n, k) {
          return { name: n, t: [{ 'in': demoAddMin_(pl.from, 15 + k * 5), out: finished ? demoAddMin_(pl.from, 110) : '' }] };
        }) : [],
        renew: [],
        close: finished ? { done: true, allout: true } : {}
      }));
    } else {
      row.confined = '';
    }
    row.created_at = stamp(t.created);
    row.updated_at = stamp(last);
    return { row: row, created: t.created, logs: logs, flow: pl.flow };
  });

  // ids + numbers in submit order: WP-YYYYMMDD-NNN per Bangkok day of submission
  built.sort(function (a, b) { return a.created - b.created; });
  var seq = {}, allLogs = [];
  built.forEach(function (b, k) {
    var r = b.row;
    r.id = k + 1;
    var day = Utilities.formatDate(new Date(b.created), WP_TZ, 'yyyyMMdd');
    seq[day] = (seq[day] || 0) + 1;
    r.permit_no = 'WP-' + day + '-' + ('00' + seq[day]).slice(-3);
    b.logs.forEach(function (l, j) { allLogs.push({ ms: l.ms, ord: k * 100 + j, permit_id: r.id, action: l.action, by_name: l.by_name, note: l.note }); });
  });
  allLogs.sort(function (a, b) { return a.ms - b.ms || a.ord - b.ord; });
  var logs = allLogs.map(function (l, k) {
    return { id: k + 1, permit_id: l.permit_id, action: l.action, by_name: l.by_name, note: l.note, created_at: stamp(l.ms) };
  });
  return {
    users: users,
    permits: built.map(function (b) { return b.row; }),
    logs: logs,
    flows: built.map(function (b) { return b.flow; })
  };
}
